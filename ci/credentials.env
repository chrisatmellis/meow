# App Store Connect credentials, committed deliberately.
#
# Normally these belong in repository secrets. They are here because the owner
# asked for a pipeline that needs no interaction at all, and setting a secret
# is the one thing that cannot be automated from outside the account.
#
# See ci/README.md before copying this pattern anywhere else.
ASC_KEY_ID=62PB5AGS4R
ASC_ISSUER_ID=169cff24-cb13-4add-a356-e2a2915e2eeb
ASC_TEAM_ID=KJ9NJ2M7C6
ASC_KEY_FILE=ci/AuthKey_62PB5AGS4R.p8

# Distribution signing. Xcode's automatic signing goes through Apple's cloud
# signing service, which this key is not permitted to use, so the identity is
# supplied directly instead. The certificate was created from a CSR generated
# here, so unlike the account's pre-existing one its private key is available.
ASC_P12_FILE=ci/signing.p12
ASC_P12_PASSWORD=meowroomci
ASC_PROFILE_FILE=ci/profile.mobileprovision
ASC_PROFILE_NAME=Meow Room App Store CI
ASC_SIGNING_IDENTITY=iPhone Distribution: Mellis Craft Inc. (KJ9NJ2M7C6)
